# Copy to .env; scripts/start.sh loads it automatically.
# ONTO_LOCAL_ROOTS=/absolute/path/to/read-only/source/root
# ONTO_DATA=/absolute/path/to/persistent/data
ONTO_MAX_FILE_BYTES=2097152
ONTO_MAX_ARCHIVE_BYTES=268435456
ONTO_MAX_EXTRACT_BYTES=1073741824
ONTO_MAX_ARCHIVE_ENTRIES=100000
ONTO_CONCURRENCY=2
# Fine-grained selected-repository Contents:read token. Never commit .env.
# GITHUB_TOKEN=
# Ollama is the default provider. Set the model to a name from ollama list.
ONTO_AI_PROVIDER=ollama
ONTO_AI_BASE_URL=http://127.0.0.1:11434
ONTO_AI_MODEL=
ONTO_AI_TIMEOUT_SECONDS=180
# Container-to-host Ollama address; separate from the native app URL.
# ONTO_DOCKER_AI_BASE_URL=http://host.docker.internal:11434
# Local Ollama needs no API key. Providers can also be chosen and saved in Settings → AI provider,
# which overrides these values; API keys entered there stay in server memory only.
# OpenAI (or any OpenAI-compatible HTTPS server):
# ONTO_AI_PROVIDER=openai
# ONTO_AI_BASE_URL=https://api.openai.com/v1
# ONTO_AI_API_KEY=            # or OPENAI_API_KEY
# Amazon Bedrock (credentials from the standard AWS chain: profile, SSO, env vars, role,
# or a Bedrock API key in AWS_BEARER_TOKEN_BEDROCK):
# ONTO_AI_PROVIDER=bedrock
# ONTO_AI_REGION=us-east-1
# ONTO_AI_AWS_PROFILE=
# ONTO_AI_MODEL=us.anthropic.<model-id>   # model ID or inference profile ID
# Cheap and strong model tiers are set in Settings → AI provider (they default to ONTO_AI_MODEL).
# Statements the strong model judges after each generative run (0 disables the quality check):
# ONTO_JUDGE_SAMPLE=8
# Optional pinned Open Ontologies v2.1.0 engine (RDF/OWL checks, SHACL, RDFS inference, SPARQL).
# scripts/setup_open_ontologies.sh --write-env downloads, verifies and sets both. No download at runtime.
# ONTO_OPEN_ONTOLOGIES_BIN=/absolute/path/to/open-ontologies
# ONTO_OPEN_ONTOLOGIES_SHA256=<published platform-specific SHA256>
# ONTO_OPEN_ONTOLOGIES_TIMEOUT_SECONDS=90
# ONTO_OPEN_ONTOLOGIES_OUTPUT_BYTES=33554432

# Optional: "Open in… → Graphistry" (pip install -r requirements-graphistry.txt). A personal key is preferred.
# GRAPHISTRY_SERVER=hub.graphistry.com
# GRAPHISTRY_PERSONAL_KEY_ID=
# GRAPHISTRY_PERSONAL_KEY_SECRET=
# GRAPHISTRY_USERNAME=
# GRAPHISTRY_PASSWORD=
